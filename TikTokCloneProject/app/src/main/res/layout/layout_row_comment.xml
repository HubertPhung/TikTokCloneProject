<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:layout_marginBottom="8dp"
    android:paddingVertical="8dp"
    android:paddingHorizontal="8dp"
    android:gravity="top">

    <de.hdodenhof.circleimageview.CircleImageView
        android:id="@+id/imvAvatarInComment"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@drawable/default_avatar" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp">

        <TextView
            android:id="@+id/txvUsernameInComment"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="User Name"
            android:textStyle="bold"
            android:textSize="13sp"
            android:textColor="@color/dark_text_primary" />

        <TextView
            android:id="@+id/txvComment"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Comment content"
            android:textSize="14sp"
            android:layout_marginTop="2dp"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/dark_text_primary" />

        <TextView
            android:id="@+id/txvReplyButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/dark_text_secondary"
            android:textStyle="bold"
            android:textSize="11sp"
            android:layout_marginTop="6dp"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:text="Reply"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginTop="2dp"
        android:minWidth="40dp">

        <ImageView
            android:id="@+id/imvLikeInComment"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_like"
            app:tint="@color/dark_text_secondary"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/txvTotalLikeComment"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/dark_text_secondary"
            android:textSize="12sp"
            android:layout_marginTop="2dp"
            android:text="0" />
    </LinearLayout>
</LinearLayout>
