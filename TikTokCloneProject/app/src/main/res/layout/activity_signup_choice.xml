<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/llSignupChoice"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tiktok_black"
    tools:context=".activity.SignupChoiceActivity">

    <!-- Back Button -->
    <ImageView
        android:id="@+id/btnBack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_baseline_arrow_back_24"
        android:padding="16dp"
        android:tint="@color/white"
        app:tint="@color/white"
        android:contentDescription="Back"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"/>

    <!-- Central Content Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="32dp">

        <!-- Logo -->
        <ImageView
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:src="@drawable/toptoplogo"
            android:layout_marginBottom="24dp"
            android:scaleType="fitCenter"/>

        <!-- Title -->
        <TextView
            android:id="@+id/txvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/montserrat_bold"
            android:text="@string/sign_up"
            android:textColor="@color/white"
            android:textSize="26sp"
            android:layout_marginBottom="8dp"/>

        <!-- Subtitle -->
        <TextView
            android:id="@+id/txvSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/montserrat_medium"
            android:text="Đăng nhập để theo dõi tác giả, thích video và xem bình luận."
            android:textColor="#8A8A8E"
            android:textSize="13sp"
            android:gravity="center"
            android:layout_marginBottom="32dp"/>

        <!-- Google Login Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnChoiceEmail"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            app:icon="@drawable/ic_google"
            app:iconGravity="textStart"
            app:iconPadding="12dp"
            app:iconTint="@null"
            android:fontFamily="@font/montserrat_bold"
            android:text="@string/btnChoiceEmail"
            android:textAllCaps="false"
            android:textColor="@color/black"
            app:backgroundTint="@color/white"
            app:cornerRadius="25dp"
            android:textSize="14sp"
            android:elevation="2dp"
            android:layout_marginBottom="16dp"/>

        <!-- Email & Password Login Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnChoiceEmailPassword"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:fontFamily="@font/montserrat_bold"
            android:text="Sử dụng Email &amp; Mật khẩu"
            android:textAllCaps="false"
            android:textColor="@color/white"
            app:backgroundTint="@color/transparent"
            app:strokeColor="@color/white"
            app:strokeWidth="1.5dp"
            app:cornerRadius="25dp"
            android:textSize="14sp"
            android:layout_marginBottom="24dp"/>

    </LinearLayout>

    <!-- Footer Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:gravity="center"
        android:orientation="vertical"
        android:background="#1C1C1E"
        android:padding="16dp">
        
        <TextView
            android:id="@+id/txv_alternative"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/montserrat_semibold"
            android:text="@string/sign_up_alt"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:clickable="true"/>
    </LinearLayout>

</RelativeLayout>