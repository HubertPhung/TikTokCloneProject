<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/dark_background"
    tools:context=".activity.ProfileActivity">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal">
            <Button
                android:id="@+id/btnBackProfile"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="40dp"
                android:layout_height="wrap_content"
                android:drawableTop="@drawable/ic_back"
                android:onClick="onClick"
                android:drawableTint="@color/dark_text_primary"
                app:drawableTint="@color/dark_text_primary" />
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/top_menu_bar"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:gravity="right"
            android:background="@color/dark_background"
            >

            <TextView
                android:id="@+id/text_menu"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:layout_margin="10dp"
                android:clickable="true"
                android:onClick="onClick"
                android:text="&#9776;"
                android:textAlignment="gravity"
                android:textSize="20sp"
                android:textColor="@color/dark_text_primary"></TextView>
        </LinearLayout>
    </FrameLayout>

    <de.hdodenhof.circleimageview.CircleImageView
        android:id="@+id/imvAvatarProfile"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_gravity="center"
        android:onClick="onClick"
        android:clickable="true"></de.hdodenhof.circleimageview.CircleImageView>
    <TextView
        android:id="@+id/txv_username"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="\@"
        android:layout_gravity="center"
        android:layout_margin="5dp"
        android:textSize="18dp"
        android:textStyle="bold"
        android:textColor="@color/dark_text_primary"></TextView>
    <LinearLayout
        android:id="@+id/info"
        android:layout_margin="15dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_horizontal">
        <LinearLayout
            android:id="@+id/ll_following"
            android:layout_width="80dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:clickable="true">
            <TextView
                android:id="@+id/text_following"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textStyle="bold"
                android:textSize="20dp"
                android:textColor="@color/dark_text_primary"></TextView>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Following"
                android:textSize="14dp"
                android:textColor="@color/dark_text_secondary"></TextView>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/ll_followers"
            android:layout_width="80dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:clickable="true">
            <TextView
                android:id="@+id/text_followers"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textStyle="bold"
                android:textSize="20dp"
                android:textColor="@color/dark_text_primary"></TextView>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Followers"
                android:textSize="14dp"
                android:textColor="@color/dark_text_secondary"></TextView>
        </LinearLayout>
        <LinearLayout
            android:layout_width="80dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">
            <TextView
                android:id="@+id/text_likes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textStyle="bold"
                android:textSize="20dp"
                android:textColor="@color/dark_text_primary"></TextView>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Likes"
                android:textSize="14dp"
                android:textColor="@color/dark_text_secondary"></TextView>
        </LinearLayout>
    </LinearLayout>
    <EditText
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/edt_bio"
        android:textAlignment="center"
        android:layout_gravity="center"
        android:visibility="gone"
        android:background="@null"
        android:textColor="@color/dark_text_primary"
        android:textColorHint="@color/dark_text_secondary"
        android:layout_marginBottom="10dp"
        ></EditText>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:id="@+id/layout_bio"
        android:visibility="gone"
        android:layout_margin="5dp">
        <Button
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Update"
            style="@style/tiktok_button_red"
            android:id="@+id/btn_update_bio"
            android:onClick="onClick"></Button>
        <Button
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Abort"
            android:layout_marginLeft="5dp"
            style="@style/tiktok_button_transparent"
            android:id="@+id/btn_cancel_update_bio"
            android:onClick="onClick"
            android:textColor="@color/dark_text_primary"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="10dp">

        <Button
            android:id="@+id/button_follow"
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:text="Follow"
            style="@style/tiktok_button_red"
            android:visibility="gone"
            android:layout_marginEnd="8dp"/>

        <Button
            android:id="@+id/button_message"
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:text="Message"
            style="@style/tiktok_button_transparent"
            android:visibility="gone"
            android:textColor="@color/dark_text_primary"/>

        <Button
            android:id="@+id/button_edit_profile"
            android:layout_width="180dp"
            android:layout_height="wrap_content"
            android:text="Edit profile"
            style="@style/tiktok_button_transparent"
            android:visibility="gone"
            android:textColor="@color/dark_text_primary"/>
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="30dp"
        >
    <androidx.recyclerview.widget.RecyclerView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/recycle_view_video_summary">
    </androidx.recyclerview.widget.RecyclerView>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
